  "description": "Given a user-supplied US dress size (2, 4, 6, etc.), output the corresponding size label (XS, S, M, L, etc.).",
  "code": "import java.util.Scanner;\n\npublic class ConvertDressSizeNumberToName {\n\n     public static void main(String args[]) {\n\n        Scanner scan = new Scanner(System.in);\n        System.out.print(\"\\nEnter a US dress size (2, 4, 6, 8, 10, or 12): \");\n        int size = scan.nextInt();\n        scan.close();\n    \n        String output = \"Size: \";\n\n        switch (size) {\n\t        case 2:\n\t        case 4:\n\t            output += \"XS\";\n\t            break;\n\t        case 6:\n\t            output += \"S\";\n\t            break;\n\t        case 8:\n\t            output += \"M\";\n\t            break;\n\t        case 10:\n\t            output += \"L\";\n\t            break;\n\t        case 12:\n\t            output += \"XL\";\n\t            break;\n\n\t        default:\n\t            output = \"Error: \" + size + \" is not a valid US dress size\";\n\t            break;\n        }\n\n        System.out.println(\"\\n\" + output);\n    }\n    \n}",
  "line_count": 40,
  "has_explanations": true,
