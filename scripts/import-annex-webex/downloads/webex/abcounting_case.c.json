  "description": "",
  "code": "/* Example: Counting letters A, B, C in the stream of text usig case */\n\n#include <stdio.h>\n\nvoid main() {\n\n    int ch;\n    int a = 0, b = 0, c = 0;\n\n    /* Accumulating counters in the loop */\n    while ((ch = getchar()) != EOF)\n        switch (ch) {\n            case 'a':\n            case 'A':\n                a++; break;\n            case 'b':\n            case 'B':\n                b++; break;\n            case 'c':\n            case 'C':\n                c++; break;\n        }\n\n    /* Printing results */\n    printf(\"\\nNumbers of characters:\\n\\n\");\n    printf(\"a %d; b %d; c %d; \\n\", a, b, c);\n}",
