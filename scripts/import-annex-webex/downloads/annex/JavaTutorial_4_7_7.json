  "code": "public class MainClass {\n  public static void main(String args[]) {\n    int sum = 0;\n    int[][] nums = new int[3][5];\n    for (int i = 0; i < 3; i++)\n      for (int j = 0; j < 5; j++)\n        nums[i][j] = (i + 1) * (j + 1);\n    for (int x[] : nums) {\n      for (int y : x) {\n        System.out.println(\"Value is: \" + y);\n        sum += y;\n      }\n    }\n    System.out.println(\"Summation: \" + sum);\n  }\n}",
