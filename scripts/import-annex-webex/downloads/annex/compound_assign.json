  "description": "",
  "code": "/*\tDemonstrate examples of compound assignments.  */\n#include <stdio.h>\n\nint main (void)\n{\n//\tLocal Declarations \n\tint x;\n\tint y;\n\n//\tStatements \n\tx = 10;\n\ty = 5;\n\n\tprintf(\"x: %2d  |  y: %2d \",    x, y);\n\tprintf(\"  |  x *= y + 2: %2d \", x *= y + 2);\n\tprintf(\"  |  x is now: %2d\\n\",  x);\n\n\tx = 10;\n\tprintf(\"x: %2d  |  y: %2d \",    x, y);\n\tprintf(\"  |  x /= y + 1: %2d \", x /= y + 1);\n\tprintf(\"  |  x is now: %2d\\n\",  x);\n\n\tx = 10;\n\tprintf(\"x: %2d  |  y: %2d \",     x, y);\n\tprintf(\"  |  x %%= y - 3: %2d \", x %= y - 3);\n\tprintf(\"  |  x is now: %2d\\n\", x);\n\n\treturn 0;\n}\t// main ",
