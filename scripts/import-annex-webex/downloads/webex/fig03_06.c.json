  "code": "/* Fig. 3.6: fig03_06.c\n   Class average program with counter-controlled repetition */\n#include <stdio.h>\n\n/* function main begins program execution */\nint main( void )\n{\n   int counter;\n   int grade;\n   int total;\n   int average;\n   \n   /* initialization phase */\n   total = 0;\n   counter = 1;\n   \n   /* processing phase */\n   while ( counter <= 10 ) {\n      printf( \"Enter grade: \" );\n      scanf( \"%d\", &grade );\n      total = total + grade;\n      counter = counter + 1;\n   }\n   \n   /* termination phase */\n   average = total / 10;\n\n   printf( \"Class average is %d\\n\", average );\n\n   return 0;\n}",
