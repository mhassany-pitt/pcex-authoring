      "line_no": 1,
      "code": "CREATE TABLE sailors",
      "explanation": "This example is to create table for sailors and everything to insert sailor it is required to check whether the sum of the number of sailors and the number of boats are not exceeded 100. <b>** This example is connected to the next example.</b> "
    },
    {
      "line_no": 2,
      "code": "   (sid INTEGER,",
