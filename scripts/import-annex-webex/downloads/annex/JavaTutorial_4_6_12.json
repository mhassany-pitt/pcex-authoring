  "code": " public class MainClass {\n   public static void main(String[] args) {\n     long limit = 20L;\n     long factorial = 1L;\n \n     for (long i = 1L; i <= limit; i++) {\n       factorial = 1L;\n \n       for (long factor = 2; factor <= i; factor++) {\n         factorial *= factor;\n       }\n       System.out.println(i + \"! is \" + factorial);\n     }\n   }\n }",
