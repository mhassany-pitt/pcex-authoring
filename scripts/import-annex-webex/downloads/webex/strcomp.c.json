  "description": "",
  "code": "/*\n                Example 14.2: string comparison with pointers\n                Source: K&R2, p106\n                Modified by Peter Brusilovsky\n                Objective: use of pointers in processing character arrays\n*/\n#include <stdio.h>\n#define MAXLEN 100\nint strcmp(char *p1, char *p2);\nint getline(char *line, int max);\nmain() {\n                char a[MAXLEN], b[MAXLEN];\n                int  comp;\n                getline(a, MAXLEN);\n                getline(b, MAXLEN);\n                comp = strcmp(a, b);\n                if(comp > 0)\n                                printf(\"First line is greater than second\\n\");\n                else if (comp < 0)\n                                printf(\"First line is less than second\\n\");\n                else printf(\"These lines are equal!\\n\");\n}\n/* strcmp: return <0 if s<t, 0 if s==t, >0 if s>t */\nint strcmp(char *s, char *t)\n{\n                for( ; *s == *t; s++, t++)\n                                if(*s == '\u0000')\n                                                return 0;\n                return *s - *t;\n}\n/* getline: read a line into s,  return length */\nint getline(char *s, int lim)\n{\n                int c, i;\n                for (i = 0; i < lim-1 &&(c=getchar())!= EOF && c != '\\n'; ++i)\n                                s[i] = c;\n                if (c == '\\n') {\n                                s[i] = c;\n                                ++i;\n                }\n                s[i] = '\u0000';\n                return i;\n}",
  "line_count": 43,
