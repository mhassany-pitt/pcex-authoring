  "description": "This program demonstrates the multiplication of two matrices using a two-dimensional array",
  "code": "public class MatrixMultiply {\n    public static void main(String[] args) {\n\n        int r1 = 2, c1 = 2;\n        int r2 = 2, c2 = 2;\n        int[][] x = { {1,2},{3,4} };\n        int[][] y = { {4,5}, {6,7} };\n        int[][] xy = new int[r1][c2];\n        \n        \n        for(int i = 0; i < r1; i++) {\n            for (int j = 0; j < c2; j++) {\n                for (int k = 0; k < c1; k++) {\n                    xy[i][j] += x[i][k] * y[k][j];\n                }\n            }\n        }\n        \n\n        for(int[] row : xy) {\n            for (int column : row) {\n                System.out.print(column + \"    \");\n            }\n            System.out.println();\n        }\n    }\n\n}",
