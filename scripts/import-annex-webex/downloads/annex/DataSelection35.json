  "description": "View Creation (2)",
  "code": "CREATE VIEW all_customer AS \n    (SELECT branch_name, customer_name\n        FROM depositor, account\n        WHERE depositor.account_no = account.account_no)\n     UNION\n    (SELECT branch_name, customer_name\n        FROM borrower, loan\n        WHERE borrower.loan_no = loan.loan_no);",
  "line_count": 8,
  "has_explanations": true,
  "lines": [
    {
      "line_no": 1,
      "code": "CREATE VIEW all_customer AS ",
      "explanation": "A VIEW is a virtual table in the database whose contents are defined by a query. To users, the VIEW appears like a real table, but the rows and columns of data visible through the VIEW are the query results produced by the query defining the VIEW. "
    },
    {
      "line_no": 2,
      "code": "    (SELECT branch_name, customer_name",
      "explanation": "This is the first query is to find the customers having account and the branch."
    },
    {
      "line_no": 3,
      "code": "        FROM depositor, account",
      "explanation": ""
    },
    {
      "line_no": 4,
      "code": "        WHERE depositor.account_no = account.account_no)",
      "explanation": ""
    },
    {
      "line_no": 5,
      "code": "     UNION",
      "explanation": "VIEW is for multi-table combination as a one table. Hence, by using UNION it is possible to add up two different SQL query results. UNION is to combine two results from separate queries into one results without duplicate."
    },
    {
      "line_no": 6,
      "code": "    (SELECT branch_name, customer_name",
      "explanation": "This is the second query to find the customers having loan and the branch."
    },
    {
      "line_no": 7,
      "code": "        FROM borrower, loan",
      "explanation": ""
    },
    {
      "line_no": 8,
      "code": "        WHERE borrower.loan_no = loan.loan_no);",
      "explanation": ""
    }
