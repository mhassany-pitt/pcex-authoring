  "description": "Print Out a Diamond",
  "code": "class Diamond {\n    public static void main(String[] args) {\n        for (int i = 1; i < 10; i += 2) {\n            for (int j = 0; j < 9 - i / 2; j++)\n                System.out.print(\" \");\n \n            for (int j = 0; j < i; j++)\n                System.out.print(\"*\");\n \n             System.out.print(\" \");\n        }\n \n        for (int i = 7; i > 0; i -= 2) {\n            for (int j = 0; j < 9 - i / 2; j++)\n                System.out.print(\" \");\n \n            for (int j = 0; j < i; j++)\n                System.out.print(\"*\");\n \n            System.out.print(\" \");\n        }\n    }\n}",
