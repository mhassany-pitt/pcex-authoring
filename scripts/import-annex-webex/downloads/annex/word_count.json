  "description": "",
  "code": "#include <stdio.h>\n#include <string.h>\nint main()\n{ \n   char text[ 4 ][ 80 ], *tokenPtr;\n   int i, counter = 0;\n     \n   printf( \"Enter 4 lines of text: \\n\" );\n   \n   for ( i = 0; i <= 3; i++ )\n      gets( &text[ i ][ 0 ] );\n   \n   for ( i = 0; i <= 3; i++ ) { \n      tokenPtr = strtok( &text[ i ][ 0 ], \" \\n\" );\n      \n      while ( tokenPtr ) { \n         ++counter;\n         tokenPtr = strtok( NULL, \" \\n\" );\n      }\n   }\n   \n   printf( \"\\nThe total number of words is %d\\n\", counter );\n\n   return 0;\n}\n}",
