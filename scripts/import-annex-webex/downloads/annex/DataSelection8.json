  "lines": [
    {
      "line_no": 1,
      "code": "SELECT City, Sales, Target",
      "explanation": "This is to choose cities, the sales amount and the target amount from 'Offices' table."
    },
    {
      "line_no": 2,
      "code": "      FROM Offices ",
      "explanation": ""
    },
    {
      "line_no": 3,
      "code": "      WHERE Sales < (.8 * Target);",
      "explanation": "This is to find sales less than 80 percent of the target amount. To process this condition, SQL constructs a temporary column containing the value of the expression (.8 * Target), 'Target' is one column in 'Offices' table and then compares them with values in 'Sales' column."
