  "code": "/* Fig. 6.14: fig06_14.c\n   Demonstrating the const type qualifier with arrays */\n#include <stdio.h>\n\nvoid tryToModifyArray( const int b[] );\n\nint main( void )\n{\n   int a[] = { 10, 20, 30 };\n   tryToModifyArray( a );\n   printf(\"%d %d %d\\n\", a[ 0 ], a[ 1 ], a[ 2 ] );\n   return 0;\n}\n\nvoid tryToModifyArray( const int b[] )\n{\n   b[ 0 ] /= 2;\n   b[ 1 ] /= 2;\n   b[ 2 ] /= 2;\n}",
