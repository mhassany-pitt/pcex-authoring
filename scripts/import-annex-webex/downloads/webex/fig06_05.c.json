  "code": "/* Fig. 6.5: fig06_05.c\n   Initialize the elements of array s to the even integers from 2 to 20 */\n#include <stdio.h>\n#define SIZE 10\n\nint main( void )\n{\n   int s[ SIZE ];\n   int j;\n\n   for ( j = 0; j < SIZE; j++ ) { /* set the values */\n      s[ j ] = 2 + 2 * j;\n   }\n\n   printf( \"%s%13s\\n\", \"Element\", \"Value\" );\n\n   for ( j = 0; j < SIZE; j++ ) {\n      printf( \"%7d%13d\\n\", j, s[ j ] );\n   }\n\n   return 0;\n}",
