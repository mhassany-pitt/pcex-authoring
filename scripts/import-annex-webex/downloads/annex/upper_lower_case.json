  "code": "#include <stdio.h>\n#include <ctype.h>\n\nint main()\n{ \n   char s[ 100 ];\n   int i;\n     \n   printf( \"Enter a line of text:\\n\" );\n   gets( s );\n   \n   printf( \"\\nThe line in uppercase is:\\n\" );\n   \n   for ( i = 0; s[ i ] != '\\0'; i++ )\n      printf( \"%c\", toupper( s[ i ] ) );\n   \n   printf( \"\\n\\nThe line in lowercase is:\\n\" );\n   \n   for ( i = 0; s[ i ] != '\\0'; i++ )\n      printf( \"%c\", tolower( s[ i ] ) );\n\n   return 0;\n}\n}",
