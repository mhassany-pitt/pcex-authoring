  "description": "",
  "code": "public class EnhancedForLoopDemo\n{\n   public static void main(String[] args)\n   {\n      int[] values = new int[10];\n\n       for (int i = 0; i < values.length; i++)\n      {\n         values[i] = i * i;\n      }\n\n      int total = 0;\n      for (int element : values)\n      {\n         System.out.println(element);\n         total = total + element;\n      }\n\n      System.out.println(\"Sum: \" + total);\n   }\n}\n}",
