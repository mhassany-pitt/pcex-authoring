  "code": "/* Fig. 5.15: fig05_15.c\n   Recursive fibonacci function */\n#include <stdio.h>\n\nlong fibonacci( long n );\n\nint main( void )\n{\n   long result;\n   long number;\n\n   printf( \"Enter an integer: \" );\n   scanf( \"%ld\", &number );\n   result = fibonacci( number );\n   printf( \"Fibonacci( %ld ) = %ld\\n\", number, result );\n   \n   return 0;\n}\n\nlong fibonacci( long n )\n{\n   if ( n == 0 || n == 1 ) {\n      return n;\n   }\n   else {\n      return fibonacci( n - 1 ) + fibonacci( n - 2 );\n   }\n}",
