  "code": "/* Fig. 5.14: fig05_14.c\n   Recursive factorial function */\n#include <stdio.h>\n\nlong factorial( long number );\n\nint main( void )\n{\n   int i;\n   for ( i = 0; i <= 10; i++ ) {\n      printf( \"%2d! = %ld\\n\", i, factorial( i ) );\n   }\n\n   return 0;\n}\n\nlong factorial( long number )\n{\n   if ( number <= 1 ) {\n      return 1;\n   }\n   else {\n      return ( number * factorial( number - 1 ) );\n   }\n}",
