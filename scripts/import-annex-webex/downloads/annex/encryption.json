  "description": "",
  "code": "#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n//function prototypes\nvoid encrypt(char [], int);\nvoid decrypt(char [], int);\nmain()\n{\nchar myString[21] = {'\\0'};\nint iSelection = 0;\nint iRand;\nsrand(time(NULL));\niRand = 1 + rand() % 4; // random #, 1-4\n\nwhile ( iSelection != 4 ) {\n   printf(\"\\n\\n1\\tEncrypt Clear Text\\n\");\n   printf(\"2\\tDecrypt Cipher Text\\n\");\n   printf(\"3\\tGenerate New Key\\n\");\n   printf(\"4\\tQuit\\n\");\n   printf(\"\\nSelect a Cryptography Option: \");\n   scanf(\"%d\", &iSelection);\n\n   switch (iSelection) {\n    case 1:\n      printf(\"\\nEnter clear text: \");\n      scanf(\"%s\", myString);\n      encrypt(myString, iRand);\n      break;\n    case 2:\n      printf(\"\\nEnter cipher text: \");\n      scanf(\"%s\", myString);\n      decrypt(myString, iRand);\n      break;\n    case 3:\n      srand(time(NULL));\n      iRand = 1+ rand() % 4; // random #, 1-4\n      printf(\"\\nNew Key Generated\\n\");\n      break;\n   }  //end switch\n\n}  //end loop\n\n}  //end main\n\nvoid encrypt(char sMessage[], int random)\n{\n  int x = 0;\n\n  while ( sMessage[x] != '\\0' ) {   \n     sMessage[x] += random; \n     x++;\n} //end loop\n\n  x = 0;\n  printf(\"\\nEncrypted Message is: \");\n  while ( sMessage[x] != '\\0' ) {\n    printf(\"%c\", sMessage[x]);\n    x++;\n} //end loop\n}  //end encrypt function\n\nvoid decrypt(char sMessage[], int random)\n{\n  int x = 0;\n  x = 0;\n while ( sMessage[x] != '\\0' ) {\n     sMessage[x] = sMessage[x] - random;\n     x++;\n} //end loop\n\nx = 0;\nprintf(\"\\nDecrypted Message is: \");\nwhile ( sMessage[x] != '\\0' ) {\n  printf(\"%c\", sMessage[x]);\n  x++;\n} //end loop\n\n}  //end decrypt function",
