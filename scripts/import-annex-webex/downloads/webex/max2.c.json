  "code": "/*  Example max2 - maximum of two values\n    Goal: demonstrate the use of if-else\n    Author: Peter Brusilovsky\n */\n\n#include <stdio.h>\n\nvoid main() {\n    int a, b;\n\n    printf(\"Enter two integers: \");\n    scanf(\"%d %d\", &a, &b);\n\n    printf(\"Maximum of %d and %d \", a, b);\n    if(a < b)\n        printf(\"is %d\\n\", b);\n    else\n        printf(\"is %d\\n\", a);\n}",
