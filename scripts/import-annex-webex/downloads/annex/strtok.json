  "code": "#include <stdio.h>\n#include <string.h>\n\nint main()\n{ \n   char string[] = \"This is a sentence with 7 tokens\";\n   char *tokenPtr;\n   \n   printf( \"%s\\n%s\\n\\n%s\\n\",\n           \"The string to be tokenized is:\", string, \n           \"The tokens are:\" );\n          \n   tokenPtr = strtok( string, \" \" );\n\n   while ( tokenPtr != NULL ) { \n      printf( \"%s\\n\", tokenPtr );\n      tokenPtr = strtok( NULL, \" \" );\n   }\n\n   return 0;\n}\n}",
