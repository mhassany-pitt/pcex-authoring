  "code": "/*  Example: Simple Accumulator\n    Author: Peter Brusilovsky\n    Add numbers until 0 is entered. Prints the sum.\n */\n\n#include <stdio.h>\nvoid main () {\n    int sum = 0, nextnumber;\n\n    printf(\"Number: \");\n    scanf(\"%d\", &nextnumber); /* read first number */\n\n    while (nextnumber != 0) {\n        sum += nextnumber;\n        printf(\"Number: \");\n        scanf(\"%d\", &nextnumber);\n    }\n    printf (\"Sum = %d\\n\", sum);\n}",
