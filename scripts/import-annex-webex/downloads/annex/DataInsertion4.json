  "description": "Inserting Data (4)",
  "code": "INSERT INTO depositor\n      SELECT customer_name, loan_no\n           FROM loan, borrower\n           WHERE branch_name ='Perryridge'\n              AND loan.accont_no = borrower.account_no;",
  "line_count": 5,
  "has_explanations": true,
  "lines": [
    {
      "line_no": 1,
      "code": "INSERT INTO depositor",
      "explanation": "The data is inserted into 'depositor' table. "
    },
    {
      "line_no": 2,
      "code": "      SELECT customer_name, loan_no",
      "explanation": "To assign created accounts to customers belonging to 'Perryridge', 'customer_name' in borrower table and 'loan_no' in loan table is selected. The data stored in the target 'depositor' table are these two data."
    },
    {
      "line_no": 3,
      "code": "           FROM loan, borrower",
      "explanation": "'customer_name' is from 'borrower' table and 'loan_no' is from 'loan' table. "
    },
    {
      "line_no": 4,
      "code": "           WHERE branch_name ='Perryridge'",
      "explanation": "This is to choose customer from 'Perryridge' branch."
    },
    {
      "line_no": 5,
      "code": "              AND loan.accont_no = borrower.account_no;",
      "explanation": "This is to check whether each borrower has loan account."
    }
