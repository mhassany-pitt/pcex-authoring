  "description": "Updating Data (2)",
  "code": "UPDATE Students S\n     SET S.gpa = S.gpa*1.01\n     WHERE S.gpa >= 3.3;",
  "line_count": 3,
  "has_explanations": true,
  "lines": [
    {
      "line_no": 1,
      "code": "UPDATE Students S",
      "explanation": "The 'UPDATE' keyword is followed by table 'Students' and the table is renamed as 'S' because it is little bit long to use."
    },
    {
      "line_no": 2,
      "code": "     SET S.gpa = S.gpa*1.01",
      "explanation": "The SET clause is mandantory in UPDATE statement and it specifies which columns are to be updated. Because table name is renamed as 'S' the column name is assigned by it using dot. Each instance in 'gpa' is read, calculates 101% of the value, and is reassigned to new value."
    },
    {
      "line_no": 3,
      "code": "     WHERE S.gpa >= 3.3;",
      "explanation": "Not all instances are updated and gpas which is just equal or higher than 3.3 are selected."
    }
  ],
