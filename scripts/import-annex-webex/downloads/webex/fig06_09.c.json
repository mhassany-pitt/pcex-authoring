  "code": "/* Fig. 6.9: fig06_09.c\n   Roll a six-sided die 6000 times */\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#define SIZE 7\n\nint main( void )\n{\n   int face;\n   int roll;\n   int frequency[ SIZE ] = { 0 };\n\n   srand( time( NULL ) );\n\n   for ( roll = 1; roll <= 6000; roll++ ) {\n      face = 1 + rand() % 6;\n      ++frequency[ face ];\n   }\n\n   printf( \"%s%17s\\n\", \"Face\", \"Frequency\" );\n\n   for ( face = 1; face < SIZE; face++ ) {\n      printf( \"%4d%17d\\n\", face, frequency[ face ] );\n   }\n\n   return 0;\n}",
