  "code": "#include <stdio.h>\n#include \"calculate.h\"\nmain()\n{\n   int selection = 0;\n   float l,w,h;\n\n   printf(\"\\nThe Function Wizard\\n\");\n   printf(\"\\n1\\tDetermine perimeter of a rectangle\\n\");\n   printf(\"2\\tDetermine area of a rectangle\\n\");\n   printf(\"3\\tDetermine volume of rectangle\\n\");\n   printf(\"\\nEnter selection: \");\n   scanf(\"%d\", &selection);\n\n   switch (selection) {\n\n      case 1:\n        printf(\"\\nEnter length: \");\n        scanf(\"%f\", &l);\n        printf(\"\\nEnter width: \");\n        scanf(\"%f\", &w);\n        perimeter(l,w);\n        break;\n\n     case 2:\n        printf(\"\\nEnter length: \");\n        scanf(\"%f\", &l);\n        printf(\"\\nEnter width: \");\n        scanf(\"%f\", &w);\n        area(l,w);\n        break;\n\n     case 3:\n        printf(\"\\nEnter length: \");\n        scanf(\"%f\", &l);\n        printf(\"\\nEnter width: \");\n        scanf(\"%f\", &w);\n        printf(\"\\nEnter height: \");\n        scanf(\"%f\", &h);\n        volume(l,w,h);\n        break;\n\n   }  // end switch\n}  // end main",
