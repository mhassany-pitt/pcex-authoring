  "code": "#include <stdio.h>\nint main()\n{\n   int passes = 0, failures = 0, student = 1, result;\n\n   while ( student <= 10 ) {\n      printf( \"Enter result ( 1=pass,2=fail ): \" );\n      scanf( \"%d\", &result );\n      if ( result == 1 )       \n         passes = passes + 1;\n      else\n         failures = failures + 1;\n      student = student + 1;\n   }\n   printf( \"Passed %d\\n\", passes );\n   printf( \"Failed %d\\n\", failures );\n   return 0;   \n}",
