  "description": "Grouping and aggregating (1)",
  "code": "SELECT b.bid, COUNT(*) AS account\n     FROM boats B, reserves R\n     WHERE R.bid = B.bid AND b.color = red\n     GROUP BY B.bid;",
  "line_count": 4,
  "has_explanations": true,
  "lines": [
    {
      "line_no": 1,
      "code": "SELECT b.bid, COUNT(*) AS account",
      "explanation": ""
    },
    {
      "line_no": 2,
      "code": "     FROM boats B, reserves R",
      "explanation": "'boats' and 'reserves' tables are renamed as B and R, respectively."
    },
    {
      "line_no": 3,
      "code": "     WHERE R.bid = B.bid AND b.color = red",
      "explanation": "This condition tests two parts. Firstly, it tests whether the boats have been reserved by match the boat's bid with the bid in the 'reserves'. Secondly, the boat' color is limited to red."
    },
    {
      "line_no": 4,
      "code": "     GROUP BY B.bid;",
      "explanation": "The COUNT function is working with this GROUP BY clause. In order to calculated the number of rows, the results are group by the bid. And then, the COUNT function is performed."
    }
  ],
