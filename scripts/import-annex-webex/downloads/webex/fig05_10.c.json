  "description": "",
  "code": "/* Fig. 5.10: fig05_10.c\n   Craps */\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n\nenum Status { CONTINUE, WON, LOST };\nint rollDice( void );\nint main( void )\n{\n   int sum;\n   int myPoint;\n   enum Status gameStatus;\n   srand( time( NULL ) );\n   sum = rollDice();\n\n   switch( sum ) {\n      case 7:\n      case 11:\n         gameStatus = WON;\n         break;\n\n      case 2:\n      case 3:\n      case 12:\n         gameStatus = LOST;\n         break;\n\n      default:\n         gameStatus = CONTINUE;\n         myPoint = sum;\n         printf( \"Point is %d\\n\", myPoint );\n         break;\n   }\n\n   while ( gameStatus == CONTINUE ) {\n      sum = rollDice();\n\n      if ( sum == myPoint ) {\n         gameStatus = WON;\n      }\n      else {\n         if ( sum == 7 ) {\n            gameStatus = LOST;\n         }\n      }\n   }\n\n   if ( gameStatus == WON ) {\n      printf( \"Player wins\\n\" );\n   }\n   else {\n      printf( \"Player loses\\n\" );\n   }\n   return 0;\n}\n\nint rollDice( void )\n{\n   int die1;\n   int die2;\n   int workSum;\n   die1 = 1 + ( rand() % 6 );\n   die2 = 1 + ( rand() % 6 );\n   workSum = die1 + die2;\n   printf( \"Player rolled %d + %d = %d\\n\", die1, die2, workSum );\n   return workSum;\n}",
  "line_count": 68,
