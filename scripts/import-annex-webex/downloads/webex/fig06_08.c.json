  "code": "/* Fig. 6.8: fig06_08.c\n   Histogram printing program */\n#include <stdio.h>\n#define SIZE 10\n\nint main( void )\n{\n   int n[ SIZE ] = { 19, 3, 15, 7, 11, 9, 13, 5, 17, 1 };\n   int i;\n   int j;\n\n   printf( \"%s%13s%17s\\n\", \"Element\", \"Value\", \"Histogram\" );\n\n   for ( i = 0; i < SIZE; i++ ) {\n      printf( \"%7d%13d        \", i, n[ i ]) ;\n\n      for ( j = 1; j <= n[ i ]; j++ ) {\n         printf( \"%c\", '*' );\n       }\n\n      printf( \"\\n\" );\n   }\n\n   return 0;\n}",
