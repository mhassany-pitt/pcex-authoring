  "code": "/* sentinel value to control the loop/repetition */\n#include <stdio.h>\nint main()\n{\n   float averageScore;              \n   int keepCounter, score, totalScore;\n   \n   totalScore = 0;\n   keepCounter = 0;\n   \n   printf( \"Enter a score, -9 to end: \" );\n   scanf( \"%d\", &score );\n   while ( score != -9 ) {\n      totalScore = totalScore + score;\n      keepCounter = keepCounter + 1; \n      printf( \"Enter a score, -9 to end: \" );\n      scanf(\"%d\", &score);\n   }\n   if ( keepCounter != 0 ) {\n      averageScore = ( float ) totalScore / keepCounter;\n      printf( \"Class average is %.2f\\n\", averageScore );\n   }\n   else\n      printf( \"No grades were entered\\n\" );\n   return 0;  \n}",
