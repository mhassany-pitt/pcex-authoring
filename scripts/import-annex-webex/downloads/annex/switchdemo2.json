  "description": "",
  "code": "//Sun Java Tutorial, Learning the Java Language>>Language Basics>>The switch Statement\n//SwitchDemo2\nclass SwitchDemo2 {\n    public static void main(String[] args) {\n\n        int month = 2;\n        int year = 2000;\n        int numDays = 0;\n\n        switch (month) {\n            case 1:\n            case 3:\n            case 5:\n            case 7:\n            case 8:\n            case 10:\n            case 12:\n                numDays = 31;\n                break;\n            case 4:\n            case 6:\n            case 9:\n            case 11:\n                numDays = 30;\n                break;\n            case 2:\n                if ( ((year % 4 == 0) && !(year % 100 == 0))\n                     || (year % 400 == 0) )\n                    numDays = 29;\n                else\n                    numDays = 28;\n                break;\n            default:\n                System.out.println(\"Invalid month.\");\n                break;\n        }\n        System.out.println(\"Number of Days = \" + numDays);\n    }\n}",
