  "description": "Assertion Creation (1)",
  "code": "CREATE TABLE sailors\n   (sid INTEGER,\n    sname CHAR(10),\n    rating INTEGER,\n    age REAL,\n    PRIMARY KEY (sid),\n    CHECK\n    ((SELECT COUNT(S.sid) \n     FROM sailor S) + \n    (SELECT COUNT(B.sid) \n     FROM boats B)\n     < 100));",
  "line_count": 12,
  "has_explanations": true,
  "lines": [
