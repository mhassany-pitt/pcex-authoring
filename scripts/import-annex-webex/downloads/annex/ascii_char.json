  "code": "#include <stdio.h>\n\nint main()\n{ \n   int c;\n   \n   printf( \"Enter an ASCII character code ( EOF to end ): \" );\n     \n   while ( scanf( \"%d\", &c ) != EOF ) { \n      if ( c >= 0 && c <= 255 )\n         printf( \"The corresponding character is '%c'\\n\", c );\n      else\n         printf( \"Invalid character code\\n\" );\n      \n      printf( \"\\nEnter an ASCII character code ( EOF to end ): \" );\n   }\n\n   return 0;\n}\n}",
