  "description": "Given an collection of test scores with values between 0 and 100, find and display the low and high scores on the test.",
  "code": "public class FindHighAndLowScores {\n\n    public static void main(String[] args) {\n\n        final int SCORES[] = { 41, 80, 47, 38, 59, 74, 56, 37, 85, 27, 49, 61, 25, 81, 95 };\n\n        int low_score = 100;\n        int high_score = 0;\n        int i = 0;\n\n        do {\n            if (SCORES[i] < low_score) {\n                low_score = SCORES[i];\n            }\n            if (SCORES[i] > high_score) {\n                high_score = SCORES[i];\n            }\n            i++;\n\n        } while (i < SCORES.length);\n\n        System.out.println(\"\");\n        System.out.println(\"Low Score: \" + low_score);\n        System.out.println(\"High Score: \" + high_score);\n    }\n\n}",
