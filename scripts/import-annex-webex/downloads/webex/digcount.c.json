  "description": "",
  "code": "/*  Example 8.4 Digit Counting\n    Source: K&R2, p.22\n */\n\n#include <stdio.h>\n\n/* count digits, white space, others */\n\nmain () {\n    int c, i, nwhite, nother;\n    int ndigit[10];\n\n    /* initialize */\n    nwhite = nother = 0;\n    for(i = 0; i < 10; ++i) ndigit[i] = 0;\n\n    /* count */\n    while ((c = getchar()) != EOF)\n        if (c >= '0' && c <= '9')\n            ++ndigit[c - '0'];\n        else if (c == ' ' || c == '\\n' || c == '    ')\n            ++nwhite;\n        else\n            ++nother;\n\n    /* report */\n    printf(\"digits =\");\n    for(i = 0; i < 10; ++i)\n        printf(\" %d\", ndigit[i]);\n    printf(\", white space = %d, other = %d\\n\", nwhite, nother);\n}",
  "line_count": 31,
