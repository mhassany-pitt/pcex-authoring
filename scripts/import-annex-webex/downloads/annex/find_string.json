  "description": "",
  "code": "#include <stdio.h>\n#include <string.h>\n\nint main()\n{ \n   int i, length;\n   char array[ 5 ][ 20 ];\n      \n   for ( i = 0; i <= 4; i++ ) { \n      printf( \"Enter a string: \" );\n      scanf( \"%s\", &array[ i ][ 0 ] );\n   }\n   \n   printf( \"\\nThe strings ending with \\\"NG\\\" are:\\n\" );\n   \n   for ( i = 0; i <= 4; i++ ) { \n      length = strlen( &array[ i ][ 0 ] );\n      \n      if ( strcmp( &array[ i ][ length - 2 ], \"NG\" ) == 0 )\n         printf( \"%s\\n\", &array[ i ][ 0 ] );\n   }\n\n   return 0;\n}\n}",
