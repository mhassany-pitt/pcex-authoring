  "code": "#include <stdio.h>\nlong factorial( long );\n\nint main()\n{\n   int i;\n   for ( i = 1; i <= 10; i++ )\n      printf( \"%2d! = %ld\\n\", i, factorial( i ) );\n   return 0;\n}\n\nlong factorial( long number )\n{\n   if ( number <= 1 )\n      return 1;\n   else\n      return ( number * factorial( number - 1 ) );\n}",
