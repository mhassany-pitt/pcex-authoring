  "demo_url": "https://acos.cs.vt.edu/html/annotated/acos-annex-sql/TableCreation3",
  "description": "Primary Key and Unique Key",
  "code": "CREATE TABLE Enrolled\n     (eid CHAR(20) NOT NULL, \n      sid CHAR(20),\n      cid CHAR(20),\n      PRIMARY KEY (eid),\n      UNIQUE (sid, cid));",
  "line_count": 6,
  "has_explanations": true,
  "lines": [
    {
      "line_no": 1,
      "code": "CREATE TABLE Enrolled",
      "explanation": "Students can take a single course only once, not more than once."
    },
    {
      "line_no": 2,
      "code": "     (eid CHAR(20) NOT NULL, ",
      "explanation": "This column is for enrollment ID and it is defined as primary key. Hence, the value should be unique among rows of the table"
    },
    {
      "line_no": 3,
      "code": "      sid CHAR(20),",
      "explanation": "This column is for student ID and it is defined as a part of candidate key which is defined in UNIQUE clause. "
    },
    {
      "line_no": 4,
      "code": "      cid CHAR(20),",
      "explanation": "This course ID is also another part of candidate key which is defined in UNIQUE clause. "
    },
    {
      "line_no": 5,
      "code": "      PRIMARY KEY (eid),",
      "explanation": "If there is more than one same eids, there is integrity error. "
    },
    {
      "line_no": 6,
      "code": "      UNIQUE (sid, cid));",
      "explanation": "UNIQUE keyword is to specify an unique value in every row, but not the primary key of a table. The unique values which can be primary key is called as candidate key. In this example, the pair of cid and sid should be unique. A student whose sid is 1324 can enroll in 'DB Management' course once but not more than once. Howver, the student can take other classes having differnt cids. It is possible to define the UNIQUE key as an attribute constraint. "
    }
  ],
