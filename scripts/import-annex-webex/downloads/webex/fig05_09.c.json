  "code": "/* Fig. 5.9: fig05_09.c\n   Randomizing die-rolling program */\n#include <stdlib.h>\n#include <stdio.h>\n\nint main( void )\n{\n   int i;\n   unsigned seed;\n   \n   printf( \"Enter seed: \" );\n   scanf( \"%u\", &seed );\n\n   srand( seed );\n   \n   for ( i = 1; i <= 10; i++ ) {\n      printf( \"%10d\", 1 + ( rand() % 6 ) );\n      if ( i % 5 == 0 ) {\n         printf( \"\\n\" );\n      }\n   }\n\n   return 0;\n}",
