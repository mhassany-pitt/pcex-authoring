  "description": "",
  "code": "#include <stdio.h>\n#include <string.h>\n\nvoid reverseTokens( char * );\n\nint main()\n{ \n   char text[ 80 ];\n   \n   printf( \"Enter a line of text:\\n\" );\n   gets( text );\n   reverseTokens( text );\n\n   return 0;\n}\n\nvoid reverseTokens( char *sentence )\n{ \n   char *pointers[ 50 ], *temp;\n   int count = 0, i;\n   \n   temp = strtok( sentence, \" \" );\n   \n   while ( temp ) { \n      pointers[ count++ ] = temp;\n      temp = strtok( NULL, \" \" );\n   }\n   \n   printf( \"The tokens in reverse order are:\\n\" );\n\n   for ( i = count - 1; i >= 0; i-- )\n      printf( \"%s \", pointers[ i ] );   \n}\n}",
