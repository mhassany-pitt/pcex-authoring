  "description": "Check Constraint (1)",
  "code": "CREATE TABLE Reserves\n    (sname CHAR(10),\n     bid INTEGER,\n     day DATE,\n     PRIMARY KEY(bid, day),\n     CONSTRAINT noInterlakeRes\n     CHECK\n      ('Interlake' <>\n             (SELECT B.bname\n              FROM boats B\n              WHERE B.bid = bid)));",
  "line_count": 11,
  "has_explanations": true,
  "lines": [
    {
      "line_no": 1,
      "code": "CREATE TABLE Reserves",
      "explanation": "This is to create table named 'Reserves'. It has three columns - sname, bid, and day."
    },
    {
      "line_no": 2,
      "code": "    (sname CHAR(10),",
      "explanation": "'sname' column is 10 ditigs character domain type."
    },
    {
      "line_no": 3,
      "code": "     bid INTEGER,",
      "explanation": "'bid' is integer domain type."
    },
    {
      "line_no": 4,
      "code": "     day DATE,",
      "explanation": "'day' is date domain type."
    },
    {
      "line_no": 5,
      "code": "     PRIMARY KEY(bid, day),",
      "explanation": "One boat have to be reserved once in a day."
    },
    {
      "line_no": 6,
      "code": "     CONSTRAINT noInterlakeRes",
      "explanation": "This is to define CHECK constraint. Before defining constraint, it is capable to specify the constraint name. The following CHECK constraint is named as 'noInterlakeRes'."
    },
    {
      "line_no": 7,
      "code": "     CHECK",
      "explanation": "CHECK contraint is a search condition that produces a true/false value. When a check constraint is specified for a column, the DBMS authomatically checks the value of that column each time a new row is inserted or a row is updated to ensure that the search condition is true. A column check constraint is specified as part of the column definition within the CREATE TABLE statement."
    },
    {
      "line_no": 8,
      "code": "      ('Interlake' <>",
      "explanation": "In this example, CHECK constraint named 'noInterlakeRes' is to check whether the name of boat ('bname') that a person want to reserve is 'Interlake'. It is to limit the reservation of 'Interlake' boat."
    },
    {
      "line_no": 9,
      "code": "             (SELECT B.bname",
      "explanation": "This subquery is to specify the condition should be checked for 'Interlake' column. This subquery is to read boat name from 'boats' table. "
    },
    {
      "line_no": 10,
      "code": "              FROM boats B",
      "explanation": ""
    },
    {
      "line_no": 11,
      "code": "              WHERE B.bid = bid)));",
      "explanation": "This is to read boat name in 'boats' table corresponding to the boat id. "
    }
