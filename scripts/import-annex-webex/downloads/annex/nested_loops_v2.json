  "code": "public class nested_loops\n{\n       public static void main(String[] args)\n       {\n            for(int i=0;i<7;i++) { \n                for(int j=7;j>i;j--) { \n                     System.out.print(\"*\"); \n                } \n                System.out.println(); \n            }\n       }\n}",
