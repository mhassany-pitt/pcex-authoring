  "code": "#include <stdio.h>\n#include <stdlib.h>  /* needed for exit() */\nint main()\n{\n  char descrip[10];\n  double price;\n  FILE *inFile;\n  inFile = fopen(\"prices.dat\",\"r\");\n  if (inFile == NULL)\n  {\n    printf(\"\\nFailed to open the file.\\n\");\n    exit(1);\n  }\n  while (fscanf(inFile, \"%s %lf\",descrip,&price) != EOF)\n    printf(\"%-9s %5.2f\\n\",descrip,price);\n  fclose(inFile);\n  return 0;\n}\n}",
